# ==============================================================================
# InvestWise Production Environment Configuration
# ==============================================================================

# Application Environment (production / development)
APP_ENV=production

# Backend Service Port
PORT=8080

# PostgreSQL Database Credentials
POSTGRES_USER=investwise_admin
POSTGRES_PASSWORD=replace_with_a_secure_database_password
POSTGRES_DB=investwise
DATABASE_URL=postgres://investwise_admin:replace_with_a_secure_database_password@postgres:5432/investwise?sslmode=disable

# Redis Connection URL
REDIS_URL=redis://redis:6379/0

# Authentication Security (Generate with: openssl rand -base64 32)
JWT_SECRET=replace_with_a_long_random_secure_jwt_secret_key_32_chars
JWT_TTL_HOURS=24

# Background Worker & Risk Calculation Engine
WORKER_COUNT=8
RISK_FREE_RATE=0.04
MARKET_UPDATE_INTERVAL_MS=1500

# Public HTTP/HTTPS Port for Nginx Reverse Proxy
HTTP_PORT=80
HTTPS_PORT=443
